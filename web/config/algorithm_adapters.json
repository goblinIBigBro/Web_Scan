    {
      "family": "gaussian-splatting-lightning",
      "label": "Gaussian Splatting Lightning",
      "category": "framework",
      "representation": "sh",
      "compatibility": "viewer-ready",
      "repo_type": "external",
      "repo_path": "../gaussian-splatting-lightning-main",
      "repo_url": "https://github.com/yzslab/gaussian-splatting-lightning",
      "default_cwd": "../gaussian-splatting-lightning-main",
      "operations": {
        "train": {
          "enabled": true,
          "template": "python main.py fit --data.parser {workspace}"
        },
        "render": {
          "enabled": true,
          "template": "python main.py validate --data.parser {workspace}"
        },
        "process_frame": {
          "enabled": true,
          "template": "python ../web/tools/realtime_adapter_bridge.py --adapter gaussian-splatting-lightning --representation sh --mode copy-and-scene --input {input_path} --output-dir {output_dir} --repo-path {repo_path}"
        },
        "export_scene": {
          "enabled": true,
          "input_kind": "ply"
        }
      },
      "requirements": {
        "python_modules": [
          "torch",
          "lightning",
          "jsonargparse",
          "wandb",
          "viser",
          "plyfile",
          "diff_gaussian_rasterization",
          "simple_knn"
        ],
        "install_commands": {
          "cuda121": [
            "python -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121",
            "python -m pip install lightning",
            "python -m pip install jsonargparse",
            "python -m pip install wandb plyfile==0.8.1 viser==0.2.3",
            "python -m pip install --no-build-isolation git+https://github.com/graphdeco-inria/diff-gaussian-rasterization.git@59f5f77e3ddbac3ed9db93ec2cfe99ed6c5d121d",
            "python -m pip install --no-build-isolation git+https://github.com/yzslab/simple-knn.git@44f764299fa305faf6ec5ebd99939e0508331503"
          ],
          "cpu": [
            "python -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu",
            "python -m pip install lightning",
            "python -m pip install jsonargparse",
            "python -m pip install wandb plyfile==0.8.1 viser==0.2.3"
          ]
        }
      },
      "notes": "train/render require torch and lightning; {workspace} for train must be a valid parser input path."
    },
